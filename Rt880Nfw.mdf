//fldigi macro definition file extended
// This file defines the macro structure(s) for the digital modem program, fldigi
// It also serves as a basis for any macros that are written by the user
//
// The top line of this file should always be the first line in every macro 
// definition file (.mdf) for the fldigi program to recognize it as such.
//

//
// Macro # 1
/$ 0 VFO A
<RIGCAT: 56 20 41 0D:ret>

//
// Macro # 2
/$ 1 VFO B
<RIGCAT: 56 20 42 0D:ret>

//
// Macro # 3
/$ 2 VFO C
<RIGCAT: 56 20 43 0D:ret>

//
// Macro # 4
/$ 3 Mode Frequence
<RIGCAT: 4D 20 30 0D:ret>

//
// Macro # 5
/$ 4 
<RIGCAT: 50 20 31 0D 50 20 58 0D:ret>\n


//
// Macro # 6
/$ 5 
\n
op:  <MYNAME>\n
qth: <MYQTH>\n
loc: <MYLOC>\n


//
// Macro # 7
/$ 6 
\n
<< <MYCALL>, <MYNAME> >>\n
Age:   \n
Rig:   \n
Pwr:   \n
Ant:   \n
OS:    \n
Soft:  <VER>\n
Web:   \n
Email: 

//
// Macro # 8
/$ 7 


//
// Macro # 9
/$ 8 Radio on
<RIGCAT: 50 20 38 0D:ret>\n
<RIGCAT: 50 20 58 0D:ret>

//
// Macro # 10
/$ 9 Radio off
<RIGCAT: 50 20 52 0D:ret>\n
<RIGCAT: 50 20 58 0D:ret>

//
// Macro # 11
/$ 10 
<RX>

//
// Macro # 12
/$ 11 
<TX>\n
de <MYCALL> k\n
<RX>

//
// Macro # 13
/$ 12 Monitor
<RIGCAT: 50 20 53 0D 50 20 58 0D:ret>\n


